{
  "$schema": "https://biomejs.dev/schemas/2.0.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "apps/*/src/**",
      "!apps/*/src/routeTree.gen.ts",
      "!apps/*/src/generated/**",
      "apps/*/vite.config.ts",
      "apps/*/vitest.config.ts",
      "apps/*/vite-plugins/**/*.ts",
      "apps/*/package.json",
      "apps/*/tsconfig.json",
      "packages/*/src/**",
      "tooling/vite/**/*.ts",
      "packages/*/components.json",
      "packages/*/package.json",
      "packages/*/tsconfig.json",
      "package.json",
      "tsconfig.base.json",
      "biome.json",
      "knip.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentWidth": 2,
    "indentStyle": "space",
    "lineWidth": 120
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error",
        "useExhaustiveDependencies": "off"
      },
      "suspicious": {
        "noExplicitAny": "warn",
        "noArrayIndexKey": "off"
      },
      "style": {
        "noNestedTernary": "error",
        "useImportType": "error",
        "noInferrableTypes": "error",
        "noNonNullAssertion": "error",
        "noParameterAssign": "error",
        "noUnusedTemplateLiteral": "error",
        "useAsConstAssertion": "error",
        "useConst": "error",
        "useDefaultParameterLast": "error",
        "useEnumInitializers": "error",
        "useNumberNamespace": "error",
        "useSelfClosingElements": "error",
        "useSingleVarDeclarator": "error",
        "useTemplate": "error"
      },
      "complexity": {
        "noForEach": "off",
        "useLiteralKeys": "warn"
      },
      "performance": {
        "noDelete": "warn"
      },
      "a11y": {
        "noStaticElementInteractions": "off",
        "noSvgWithoutTitle": "off",
        "useAltText": "error",
        "useKeyWithClickEvents": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "jsxQuoteStyle": "double",
      "quoteStyle": "single"
    }
  },
  "overrides": [
    {
      "includes": [
        "apps/app/src/lib/candidates/search/**",
        "apps/app/src/components/features/candidates/**",
        "apps/app/src/hooks/queries/use-query-candidate-*.ts",
        "apps/app/src/hooks/use-candidate-directory-profiles.ts",
        "packages/crypto/src/candidate-search*.ts",
        "packages/crypto/src/candidate-search-cache/**",
        "packages/crypto/src/proxy/**",
        "packages/crypto/src/worker/candidate-search*.ts",
        "packages/crypto/src/remembered-device-store.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "useBlockStatements": "error",
            "noNestedTernary": "error"
          }
        }
      }
    }
  ]
}
