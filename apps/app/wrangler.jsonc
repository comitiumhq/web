{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "comitium-app",
	"main": "@tanstack/react-start/server-entry",
	"compatibility_date": "2025-09-13",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"preview_urls": false,
	"observability": { "enabled": true },
	"env": {
		"dev": {
			"name": "comitium-app-dev",
			"routes": [{ "pattern": "app-dev.comitium.co", "custom_domain": true }]
		},
		"prod": {
			"name": "comitium-app",
			"routes": [{ "pattern": "app.comitium.co", "custom_domain": true }]
		}
	}
}
