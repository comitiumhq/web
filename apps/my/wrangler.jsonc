{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "comitium-my",
	"main": "@tanstack/react-start/server-entry",
	"compatibility_date": "2025-09-13",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"preview_urls": false,
	"observability": { "enabled": true },
	"env": {
		"dev": {
			"name": "comitium-my-dev",
			"routes": [{ "pattern": "my-dev.comitium.co", "custom_domain": true }]
		},
		"prod": {
			"name": "comitium-my",
			"routes": [{ "pattern": "my.comitium.co", "custom_domain": true }]
		}
	}
}
