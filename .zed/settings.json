{
  "lsp": {
    "biome": {
      "settings": {
        "require_config_file": true
      }
    }
  },
  "languages": {
    "JavaScript": {
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "bunx",
          "arguments": ["biome", "format", "--stdin-file-path", "{buffer_path}"]
        }
      }
    },
    "JSX": {
